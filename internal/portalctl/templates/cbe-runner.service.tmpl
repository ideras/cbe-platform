[Unit]
Description=CBE runner: the only holder of the container runtime's socket (user unit of {{.RunnerUser}}, with lingering)
After=podman.socket
Wants=podman.socket

[Service]
Type=simple
ExecStart={{.InstallDir}}/bin/cbe-runner -config {{.InstallDir}}/etc/runner.json
Restart=on-failure
RestartSec=2
# The containers it makes are the runtime's, not this unit's: stopping the runner leaves them running (they are found again).
KillMode=process

[Install]
WantedBy=default.target
