[Unit]
Description=CBE quota helper: size-limited /work folders for workspace exams (root, serves only {{.RunnerUser}})
After=local-fs.target
RequiresMountsFor={{.WorkDir}}

[Service]
Type=simple
ExecStart={{.InstallDir}}/bin/cbe-quota-helperd -volume {{.WorkDir}} -state {{.Data}} -socket /run/cbe-quota/helper.sock -runner {{.RunnerUser}}
Restart=on-failure
RestartSec=2
# It only needs to set XFS project quotas and make folders on the volume.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{.Data}} /run/cbe-quota
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
RuntimeDirectory=cbe-quota
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
